import pandas as pd
from urllib.parse import urlparse, parse_qsl, urlencode

def normalize_url(url):
    """
    Normalize a URL by:
    - Removing trailing slashes
    - Converting to lowercase
    - Sorting query parameters
    - Removing invisible characters
    """

    try:
        # Strip invisible characters (e.g., whitespace, non-printable characters)
        url = ''.join(c for c in url if c.isprintable()).strip()

        # Parse the URL into components
        parsed_url = urlparse(url)

        # Normalize the netloc (host) and path
        normalized_netloc = parsed_url.netloc.lower()
        normalized_path = parsed_url.path.rstrip('/').lower()

        # Normalize query parameters (sorted and encoded)
        query_params = parse_qsl(parsed_url.query, keep_blank_values=True)
        normalized_query = urlencode(sorted(query_params))

        # Reassemble the URL
        normalized_url = urlunparse((
            parsed_url.scheme,      # Scheme (http/https)
            normalized_netloc,      # Host
            normalized_path,        # Path
            parsed_url.params,      # Params
            normalized_query,       # Query
            parsed_url.fragment     # Fragment
        ))

        return normalized_url

    except Exception as e:
        # Return the original URL if normalization fails
        return url


